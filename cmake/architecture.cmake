# Select dependency binaries from the compiler ABI, never from the host OS.
if(NOT WIN32 OR NOT MSVC)
  message(FATAL_ERROR "cod4x1khz currently requires Windows and MSVC")
endif()
if(NOT CMAKE_CXX_COMPILER_ARCHITECTURE_ID MATCHES "^(X86|x64)$")
  message(FATAL_ERROR "Unsupported CPU architecture: ${CMAKE_CXX_COMPILER_ARCHITECTURE_ID}")
endif()
if(CMAKE_SIZEOF_VOID_P EQUAL 8)
  set(KHZ_ARCH x64)
  set(KHZ_TOOL_OUTPUT_DIR "${CMAKE_SOURCE_DIR}/runtime/tools/x64")
elseif(CMAKE_SIZEOF_VOID_P EQUAL 4)
  set(KHZ_ARCH x86)
  set(KHZ_TOOL_OUTPUT_DIR "${CMAKE_SOURCE_DIR}/runtime/tools")
else()
  message(FATAL_ERROR "Unsupported pointer size: ${CMAKE_SIZEOF_VOID_P}")
endif()
set(KHZ_DXSDK_NATIVE "${CMAKE_SOURCE_DIR}/.deps/dxsdk/9.29.952.8/build/native")
set(KHZ_D3DX9_LIBRARY "${KHZ_DXSDK_NATIVE}/release/lib/${KHZ_ARCH}/d3dx9.lib")
set(KHZ_D3DX9_RUNTIME "${KHZ_DXSDK_NATIVE}/release/bin/${KHZ_ARCH}/D3DX9_43.dll")
message(STATUS "cod4x1khz compiler ABI: ${KHZ_ARCH}")
